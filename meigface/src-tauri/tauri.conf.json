{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MeigFACE",
  "version": "1.5.0",
  "identifier": "com.giuliomagini.meigface",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "MeigFACE",
        "width": 1280,
        "height": 800,
        "maximized": true,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; media-src 'self' blob:; frame-src 'self' blob:; connect-src 'self' http://127.0.0.1:8080 http://127.0.0.1:8081; worker-src 'self' blob:",
      "dangerousDisableAssetCspModification": ["script-src"]
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "publisher": "Giulio Magini",
    "targets": "all",
    "resources": {
      "../voices": "voices"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}